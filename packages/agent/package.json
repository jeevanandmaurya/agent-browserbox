{
  "name": "@jeevanand/agent-browserbox",
  "version": "0.2.0",
  "description": "The BrowserBox agent as a library: works inside a BrowserBox with file, search, shell, code, dev-server and publishing tools, compaction, checkpoints and undo, plan mode, skills, sub-agents and MCP. Claude, OpenAI-compatible or in-browser models.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0"
  },
  "peerDependencies": {
    "@jeevanand/agent-browserbox-sdk": "^0.2.0",
    "@mlc-ai/web-llm": "^0.2.88"
  },
  "keywords": [
    "ai-agent",
    "agent",
    "coding-agent",
    "sandbox",
    "browser",
    "claude",
    "llm",
    "tool-use"
  ],
  "homepage": "https://github.com/jeevanandmaurya/agent-browserbox/tree/main/packages/agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeevanandmaurya/agent-browserbox.git",
    "directory": "packages/agent"
  },
  "bugs": {
    "url": "https://github.com/jeevanandmaurya/agent-browserbox/issues"
  },
  "author": "Jeevanand Maurya",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "peerDependenciesMeta": {
    "@mlc-ai/web-llm": {
      "optional": true
    }
  }
}

{
  "name": "@jeevanand/agent-browserbox-runtime",
  "version": "0.4.2",
  "description": "The runtime for @jeevanand/agent-browserbox-sdk: static files to serve (kernel, filesystem, shell, sandboxes), and a client library for app UIs that drive its kernel (/client).",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "import": "./lib/client/index.js"
    }
  },
  "bin": {
    "agent-browserbox-runtime": "bin/serve.mjs"
  },
  "files": [
    "dist",
    "lib",
    "bin",
    "index.js",
    "index.d.ts",
    "README.md"
  ],
  "keywords": [
    "sandbox",
    "ai-agent",
    "browser",
    "vm",
    "runtime",
    "wasm"
  ],
  "homepage": "https://github.com/jeevanandmaurya/agent-browserbox/tree/main/packages/runtime#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeevanandmaurya/agent-browserbox.git",
    "directory": "packages/runtime"
  },
  "bugs": {
    "url": "https://github.com/jeevanandmaurya/agent-browserbox/issues"
  },
  "author": "Jeevanand Maurya",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "vite build --config vite.config.ts && rm -rf lib && tsc -p tsconfig.client.json && node -e \"require('fs').copyFileSync('src/kernel/kcore.wasm','lib/kernel/kcore.wasm')\"",
    "prepack": "npm run build"
  }
}

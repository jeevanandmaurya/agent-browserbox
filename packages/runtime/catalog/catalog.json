    {
      "id": "ffmpeg",
      "version": "0.12.10",
      "kind": "js",
      "summary": "FFmpeg: convert, cut and resize video and audio, grab frames (ffmpeg, ffprobe; 32 MB, one thread)",
      "license": "GPL-2.0-or-later",
      "homepage": "https://ffmpegwasm.netlify.app",
      "files": [
        {
          "path": "lib/ffmpeg-core.js",
          "url": "https://cdn.jsdelivr.net/npm/@ffmpeg/core@0.12.10/dist/umd/ffmpeg-core.js"
        },
        {
          "path": "lib/ffmpeg-core.wasm",
          "url": "https://cdn.jsdelivr.net/npm/@ffmpeg/core@0.12.10/dist/umd/ffmpeg-core.wasm"
        },
        {
          "path": "ffmpeg.js",
          "wrapper": "ffmpeg.js"
        }
      ],
      "commands": {
        "ffmpeg": {
          "run": "ffmpeg.js",
          "load": [
            "lib/ffmpeg-core.js"
          ],
          "assets": [
            "lib/ffmpeg-core.wasm"
          ]
        },
        "ffprobe": {
          "run": "ffmpeg.js",
          "args": [
            "--ffprobe"
          ],
          "load": [
            "lib/ffmpeg-core.js"
          ],
          "assets": [
            "lib/ffmpeg-core.wasm"
          ]
        }
      }
    },
    {

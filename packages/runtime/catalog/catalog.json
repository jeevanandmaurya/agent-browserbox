      ],
      "commands": {
        "pdf": {
          "run": "pdf.js",
          "load": [
            "lib/pdf-lib.min.js",
            "lib/pdf.worker.min.js",
            "lib/pdf.min.js"
          ]
        }
      }
    },
    {
      "id": "docx",
      "version": "1.11.0",
      "kind": "js",
      "summary": "Word documents to text, HTML or Markdown (docx text|html|md, mammoth)",
      "license": "BSD-2-Clause",
      "homepage": "https://github.com/mwilliamson/mammoth.js",
      "files": [
        {
          "path": "lib/mammoth.browser.min.js",
          "url": "https://cdn.jsdelivr.net/npm/mammoth@1.11.0/mammoth.browser.min.js"
        },
        {
          "path": "docx.js",
          "wrapper": "docx.js"

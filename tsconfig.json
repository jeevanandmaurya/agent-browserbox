{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "@webgpu/types"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@jeevanand/agent-browserbox-sdk": [
        "./packages/sdk/src/index.ts"
      ],
      "@jeevanand/agent-browserbox": [
        "./packages/agent/src/index.ts"
      ],
      "@jeevanand/agent-browserbox/ui": [
        "./packages/agent/src/ui.ts"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "embed",
    "packages/sdk/src",
    "packages/agent/src"
  ]
}

{
  "name": "@jeevanand/browserbox",
  "version": "0.1.0",
  "private": true,
  "description": "BrowserBox: an operating system for AI agents that runs entirely in the browser. Released as a site (app-v* releases), not on npm.",
  "type": "module",
  "bin": {
    "browserbox": "bin/browserbox.mjs"
  },
  "keywords": [
    "ai-agent",
    "agent",
    "browser",
    "operating-system",
    "sandbox",
    "sharedworker",
    "wasm",
    "claude",
    "llm"
  ],
  "homepage": "https://jeevanandmaurya.github.io/agent-browserbox/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeevanandmaurya/agent-browserbox.git"
  },
  "bugs": {
    "url": "https://github.com/jeevanandmaurya/agent-browserbox/issues"
  },
  "author": "Jeevanand Maurya",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:sdk": "npm run build -w @jeevanand/agent-browserbox-sdk",
    "build:runtime": "BBX_TARGET=runtime vite build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "NODE_PATH=$(npm root -g) node scripts/smoke.mjs && NODE_PATH=$(npm root -g) node scripts/features.mjs",
    "e2e:sdk": "npm run build:sdk && npm run build:runtime && NODE_PATH=$(npm root -g) node scripts/sdk-e2e.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@mlc-ai/web-llm": "^0.2.88",
    "@types/sql.js": "^1.4.11",
    "@webgpu/types": "^0.1.74",
    "buffer": "^6.0.3",
    "esbuild-wasm": "^0.25.5",
    "fflate": "^0.8.3",
    "isomorphic-git": "^1.44.15",
    "sql.js": "^1.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "workspaces": [
    "packages/*"
  ]
}

{
  "name": "agent-browserbox",
  "version": "0.1.0",
  "description": "BrowserBox: an operating system for AI agents that runs entirely in the browser. The npm packages live in packages/ (sdk, app).",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeevanandmaurya/agent-browserbox.git"
  },
  "author": "Jeevanand Maurya",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "NODE_PATH=$(npm root -g) node scripts/smoke.mjs && NODE_PATH=$(npm root -g) node scripts/features.mjs",
    "build:sdk": "vite build --config vite.sdk.config.ts && tsc -p tsconfig.sdk.json",
    "test:sdk": "node scripts/sdk-test.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@mlc-ai/web-llm": "^0.2.88",
    "@types/sql.js": "^1.4.11",
    "@webcontainer/api": "^1.6.4",
    "@webgpu/types": "^0.1.74",
    "buffer": "^6.0.3",
    "esbuild-wasm": "^0.25.5",
    "fflate": "^0.8.3",
    "isomorphic-git": "^1.44.15",
    "sql.js": "^1.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "private": true
}

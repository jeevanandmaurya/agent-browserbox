{
  "name": "agent-browserbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A sandboxed agent OS that runs entirely in the browser",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "NODE_PATH=$(npm root -g) node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.74",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@mlc-ai/web-llm": "^0.2.88"
  }
}

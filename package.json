{
  "name": "agent-browserbox",
  "version": "0.3.1",
  "private": true,
  "description": "BrowserBox: the agent-browserbox SDK, runtime and agent packages, and the BrowserBox app built on them.",
  "type": "module",
  "keywords": [
    "ai-agent",
    "agent",
    "browser",
    "operating-system",
    "sandbox",
    "sharedworker",
    "wasm",
    "claude",
    "llm"
  ],
  "homepage": "https://jeevanandmaurya.github.io/agent-browserbox/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeevanandmaurya/agent-browserbox.git"
  },
  "bugs": {
    "url": "https://github.com/jeevanandmaurya/agent-browserbox/issues"
  },
  "author": "Jeevanand Maurya",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "npm run dev -w @jeevanand/browserbox",
    "build": "tsc --noEmit && npm run build:agent && npm run build:runtime && npm run build:app",
    "build:sdk": "npm run build -w @jeevanand/agent-browserbox-sdk",
    "build:agent": "npm run build:sdk && npm run build -w @jeevanand/agent-browserbox",
    "build:runtime": "npm run build -w @jeevanand/agent-browserbox-runtime",
    "build:app": "npm run build -w @jeevanand/browserbox",
    "build:wasm": "node scripts/build-wasm.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "serve": "node apps/browserbox/serve.mjs",
    "smoke": "NODE_PATH=$(npm root -g) node scripts/smoke.mjs && NODE_PATH=$(npm root -g) node scripts/features.mjs",
    "e2e:sdk": "npm run build:agent && npm run build:runtime && NODE_PATH=$(npm root -g) node scripts/sdk-e2e.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@mlc-ai/web-llm": "^0.2.88",
    "@types/sql.js": "^1.4.11",
    "@webgpu/types": "^0.1.74",
    "buffer": "^6.0.3",
    "esbuild-wasm": "^0.25.5",
    "fake-indexeddb": "^6.2.8",
    "fflate": "^0.8.3",
    "isomorphic-git": "^1.44.15",
    "sql.js": "^1.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
